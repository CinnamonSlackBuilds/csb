+    def _run_timedatectl(self, args, label, on_success=None, on_error=None):
+        if not self._proxy:
+            if on_error:
+                on_error()
+            return
+
+        flags = Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_PIPE
+        stdin_payload = None
+        if label == "SetTime":
+            flags |= Gio.SubprocessFlags.STDIN_PIPE
+            stdin_payload = "yes\n"
+
+        try:
+            proc = Gio.Subprocess.new(
+                ["/usr/bin/pkexec", "/usr/bin/timedatectl"] + args,
+                flags
+            )
+        except GLib.Error as error:
+            print(f"{label} launch error:", error.message)
+            if on_error:
+                on_error()
+            return
+
+        def _on_finished(subprocess_obj, result, user_data=None):
+            try:
+                _, _, stderr = subprocess_obj.communicate_utf8_finish(result)
+                if subprocess_obj.get_successful():
+                    if on_success:
+                        on_success()
+                else:
+                    exit_code = subprocess_obj.get_exit_status()
+                    if exit_code not in (126, 127):
+                        err_msg = stderr.strip() if stderr else f"exit status {exit_code}"
+                        print(f"{label} error:", err_msg)
+                    if on_error:
+                        on_error()
+            except GLib.Error as error:
+                print(f"{label} async error:", error.message)
+                if on_error:
+                    on_error()
+
+        proc.communicate_utf8_async(stdin_payload, None, _on_finished, None)
+
+    def set_timezone(self, zone, on_success=None, on_error=None):
